# SAMPLE ONLY. Put real values in /etc/localfrom/localfrom.env, never in Git.
# Replace every CHANGE_ME value before starting the production service.
DJANGO_SETTINGS_MODULE=jobportal.settings
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_NEW_RANDOM_SECRET
SITE_URL=https://www.localfrom.com
DJANGO_ALLOWED_HOSTS=localfrom.com,www.localfrom.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://localfrom.com,https://www.localfrom.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
# Enable HSTS after HTTPS and recovery access have been verified.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_DEMO_SIGNUP_OTP=false
DJANGO_DEMO_PASSWORD_RESET_OTP=false
# Temporary public onboarding exception; keep legacy demo flags false and DEBUG false.
# When true, signup displays a testing code, phone ownership is unverified,
# and all account OTP password recovery is unavailable. Default/recommended: false.
DJANGO_PUBLIC_DEMO_SIGNUP=false

DB_NAME=localfrom
DB_USER=localfrom_app
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=3306
REDIS_URL=redis://127.0.0.1:6379/0
OTP_REDIS_URL=redis://127.0.0.1:6379/1

STATIC_ROOT=/srv/localfrom/storage/static
MEDIA_ROOT=/srv/localfrom/storage/media
CHAT_PRIVATE_ROOT=/srv/localfrom/storage/chat
CACHE_LOCATION=/srv/localfrom/storage/cache
# News and identity private roots default to siblings of MEDIA_ROOT:
# /srv/localfrom/storage/newsdesk-private
# /srv/localfrom/storage/news-identities-private

TWO_FACTOR_API_KEY=CHANGE_ME_2FACTOR_API_KEY
TWO_FACTOR_OTP_TEMPLATE=CHANGE_ME_APPROVED_TEMPLATE
SENTRY_DSN=
GA4_MEASUREMENT_ID=
